---
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-600.css';
import '../styles/base.css';
import '../styles/chrome.css';
import '../styles/sections.css';
import '../styles/forms.css';
import '../styles/pages.css';
import condensed700 from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { LAUNCH, absoluteUrl, hours, phoneText, siteName, value, withBase } from '../lib/site';
import { localBusiness } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  bar?: boolean;
  schema?: object[];
  ogType?: string;
}

const { title, description, bar = true, schema = [], ogType = 'website' } = Astro.props;
const name = siteName();
const city = value('location').split(',')[0];
const fullTitle = title ? `${title} | ${name}` : `${name} | ${value('tradeLine')} and Roadside Assistance in ${city}, TX`;
const desc =
  description ??
  `${value('tradeLine')} and roadside assistance in ${value('location')}. DOT inspections, brakes, engine, electrical, tires and trailers. Call ${phoneText()} or request service online.`;
const ogImage = absoluteUrl('og.jpg');
const canonical = LAUNCH ? absoluteUrl(Astro.url.pathname.slice(withBase().length)) : undefined;
const jsonLd = LAUNCH ? [localBusiness(), ...schema] : [];
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#0f1318" />
    <link rel="icon" href={withBase('favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="preload" as="font" type="font/woff2" href={condensed700} crossorigin="anonymous" />
    {!LAUNCH && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && <meta property="og:image:alt" content={`${name}: ${value('tradeLine')} and roadside assistance in ${city}, Texas`} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body class:list={{ 'has-bar': bar }}>
    <a class="skip" href="#main">Skip to main content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {bar && <MobileBar />}
    <script type="application/json" id="hours-data" set:html={JSON.stringify(hours)} />
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
