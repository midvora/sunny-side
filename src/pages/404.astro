---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="That page does not exist." actions={false}>
  <div class="wrap notfound">
    <p class="kicker">Error 404</p>
    <h1>Page not found</h1>
    <p>The page you tried to open does not exist. Head back to the home page to call or request a repair.</p>
    <p><a class="btn btn--primary" href="/"><span class="btn__main">Back to home</span></a></p>
  </div>
</Base>
