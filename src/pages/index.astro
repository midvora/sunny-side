---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Steps from '../components/Steps.astro';
import Testimonials from '../components/Testimonials.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { areas, content, faqGroups, hours, phoneText, services, tel, testimonials, value, withBase } from '../lib/site';
import { hoursSummary } from '../lib/hours';

const { hero, why, process, roadside, fleet } = content.home;
const emphasis = 'keeps you moving.';
const [titleLead] = hero.title.split(emphasis);
const topFaq = [{ id: 'top', name: '', items: faqGroups.flatMap((g) => g.items).slice(0, 5) }];
const city = value('location').split(',')[0];
const [roadsideCard, ...otherServices] = [services.find((s) => s.slug === 'roadside-assistance')!, ...services.filter((s) => s.slug !== 'roadside-assistance')];
---
<Base title={`Truck & Trailer Repair and Roadside Assistance in ${city}, TX`}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <Photo name="hero-golden-hour" decorative priority sizes="(min-width: 960px) 58vw, 100vw" widths={[640, 960, 1280, 1600]} />
    </div>
    <div class="hero__copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="hero-title">{titleLead}<em>{emphasis}</em></h1>
      <p class="lead">{hero.lead}</p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href={tel()}><Icon name="phone-call" size={22} /> Call {phoneText()}</a>
        <a class="btn btn--ghost btn--lg" href={withBase('request-service/')}>Request service</a>
      </div>
      <ul class="hero__checks">
        <li><Icon name="circle-check" size={20} /> Roadside assistance</li>
        <li><Icon name="circle-check" size={20} /> DOT inspections</li>
        <li><Icon name="circle-check" size={20} /> Honest estimates</li>
      </ul>
    </div>
    <a class="hero__card" href={withBase('roadside-assistance/')}>
      <span class="pulse"><Icon name="siren" size={24} /></span>
      <span><strong>Broken down right now?</strong><span>Get roadside help</span></span>
    </a>
  </section>

  <section class="facts" aria-label="At a glance">
    <div class="wrap">
      <ul class="facts__list">
        <li><Icon name="map-pin" size={26} /><span>{value('address')}</span></li>
        <li><Icon name="clock" size={26} /><span><span data-open-status>{hoursSummary(hours)}</span><small>{hoursSummary(hours)}</small></span></li>
        <li><Icon name="siren" size={26} /><span>Roadside: {value('emergency').split('.')[0].toLowerCase()}</span></li>
        <li><Icon name="shield-check" size={26} /><span>{value('insurance')}</span></li>
      </ul>
    </div>
  </section>

  <section class="section" id="services" aria-labelledby="services-title">
    <div class="wrap">
      <SectionHead eyebrow="What we do" title="Everything your truck and trailer need" lead="From a flat on the shoulder to a full DOT inspection, one shop handles it." id="services-title" />
      <div class="grid-cards">
        <ServiceCard service={roadsideCard} featured />
        {otherServices.map((s) => <ServiceCard service={s} />)}
        <div class="scard scard--cta" data-reveal>
          <h3>Not sure what you need?</h3>
          <p>Describe what&rsquo;s going on and we&rsquo;ll tell you straight.</p>
          <a class="btn btn--dark" href={tel()}><Icon name="phone-call" size={20} /> Call {phoneText()}</a>
          <a class="btn btn--ghost-dark" href={withBase('request-service/')}>Request service</a>
        </div>
      </div>
      <p class="section__more" data-reveal><a class="btn btn--dark" href={withBase('services/')}>See all services <Icon name="arrow-right" size={20} /></a></p>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="roadside-title">
    <div class="wrap split">
      <div class="split__media" data-reveal>
        <Photo name="roadside-tire-change" sizes="(min-width: 900px) 540px, 92vw" widths={[480, 800, 1100]} />
        <div class="split__badge"><Icon name="siren" size={26} /><span>Call any time<br /><strong>{phoneText()}</strong></span></div>
      </div>
      <div data-reveal>
        <p class="eyebrow">{roadside.eyebrow}</p>
        <h2 id="roadside-title">{roadside.title}</h2>
        <p class="lead">{roadside.text}</p>
        <ul class="ticks">
          {roadside.bullets.map((b) => <li><Icon name="circle-check" size={22} /> {b}</li>)}
        </ul>
        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href={tel()}><Icon name="phone-call" size={22} /> Call now</a>
          <a class="btn btn--ghost btn--lg" href={withBase('roadside-assistance/')}>How roadside works</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="why-title">
    <div class="wrap">
      <SectionHead eyebrow="Why Sunny Side" title={why.title} lead={why.intro} id="why-title" />
      <ul class="why">
        {why.items.map((it) => (
          <li data-reveal>
            <span class="why__icon"><Icon name={it.icon} size={28} /></span>
            <h3>{it.title}</h3>
            <p>{it.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="process-title">
    <div class="wrap">
      <SectionHead eyebrow="Simple process" title={process.title} lead={process.intro} id="process-title" />
      <Steps steps={process.steps} horizontal />
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="fleet-title">
    <div class="wrap split split--flip">
      <div class="split__media" data-reveal>
        <Photo name="fleet-lot" sizes="(min-width: 900px) 540px, 92vw" widths={[480, 800, 1100]} />
      </div>
      <div data-reveal>
        <p class="eyebrow">{fleet.eyebrow}</p>
        <h2 id="fleet-title">{fleet.title}</h2>
        <p class="lead">{fleet.text}</p>
        <ul class="ticks">
          {fleet.bullets.map((b) => <li><Icon name="circle-check" size={22} /> {b}</li>)}
        </ul>
        <a class="btn btn--dark btn--lg" href={withBase('fleet-services/')}>Fleet services <Icon name="arrow-right" size={20} /></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="quotes-title">
    <div class="wrap">
      <SectionHead eyebrow="Drivers say" title="Straight talk from the road" id="quotes-title" />
      <Testimonials items={testimonials} limit={3} />
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="area-title">
    <div class="wrap split">
      <div data-reveal>
        <p class="eyebrow">Where we work</p>
        <h2 id="area-title">Based in {city}. Serving the whole metroplex.</h2>
        <p class="lead">{value('serviceModel')}.</p>
        <ul class="chips" aria-label="Cities we serve">
          {areas.cities.map((c) => (
            <li class:list={{ 'is-home': c === areas.home }}>{c === areas.home && <Icon name="map-pin" size={16} />}{c}</li>
          ))}
        </ul>
        <p class="hero__actions mt-m"><a class="btn btn--primary" href={withBase('service-area/')}>View service area</a></p>
      </div>
      <div class="split__media" data-reveal>
        <Photo name="road-sunrays" sizes="(min-width: 900px) 540px, 92vw" widths={[480, 800, 1100]} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap">
      <SectionHead eyebrow="FAQ" title="Questions drivers ask" id="faq-title" />
      <FaqList groups={topFaq} openFirst />
      <p class="section__more" data-reveal><a class="btn btn--ghost-dark" href={withBase('faq/')}>All questions</a></p>
    </div>
  </section>

  <CtaBand />
</Base>
