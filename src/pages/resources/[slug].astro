---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { articles } from '../../lib/articles';
import { LAUNCH, phoneText, tel, withBase } from '../../lib/site';
import { articleLd, breadcrumbs } from '../../lib/seo';

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug } }));
}

const { slug } = Astro.params;
const article = articles.find((a) => a.slug === slug)!;
const { Content } = article;
const more = articles.filter((a) => a.slug !== slug).slice(0, 3);
const crumbs = [{ name: 'Resources', href: 'resources/' }, { name: article.title }];
const schema = LAUNCH ? [breadcrumbs(crumbs), articleLd(article, `resources/${slug}/`)] : [];
---
<Base title={article.title} description={article.description} schema={schema} ogType="article">
  <PageHero compact eyebrow={article.category} title={article.title} image={article.image} crumbs={crumbs} actions={false}>
    <p class="article-meta">
      <span><Icon name="clock" size={18} /> {article.readTime}</span>
      <span><Icon name="calendar" size={18} /> Updated {article.updated}</span>
    </p>
  </PageHero>

  <section class="section">
    <div class="wrap detail">
      <article class="prose"><Content /></article>
      <aside class="detail__aside" aria-label="Help and more guides">
        <div class="aside-card">
          <h3>Need a hand?</h3>
          <p>Call and tell us what's going on.</p>
          <a class="btn btn--primary btn--lg" href={tel()}><Icon name="phone-call" size={22} />{phoneText()}</a>
          <p class="mt-s"><a class="btn btn--ghost btn--sm" href={withBase('request-service/')}>Request service online</a></p>
        </div>
        <div class="aside-card aside-card--light">
          <h3>More guides</h3>
          <ul class="related">
            {more.map((a) => <li><a href={withBase(`resources/${a.slug}/`)}><span class="mega__icon"><Icon name="file-text" size={18} /></span>{a.title}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
</Base>
