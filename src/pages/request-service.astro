---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import StepForm from '../components/StepForm.astro';
import HoursTable from '../components/HoursTable.astro';
import { phoneText, tel, value, withBase } from '../lib/site';

---
<Base title="Request Service" description="Request roadside help, a repair, a DOT inspection or maintenance. Tell us about your truck or trailer and we'll take it from there.">
  <PageHero
    compact
    eyebrow="Request service"
    title="Tell us what you need"
    lead="It takes about a minute. If your truck is stopped on the road, calling is faster."
    image="maintenance-yellow-cab"
    crumbs={[{ name: 'Request service' }]}
    actions={false}
  />

  <section class="section section--alt">
    <div class="wrap request-grid">
      <StepForm />
      <aside class="request-aside" aria-label="Other ways to reach us">
        <div class="aside-card">
          <h2>Stranded right now?</h2>
          <p>Skip the form. Call and tell us where you are.</p>
          <a class="btn btn--primary btn--lg" href={tel()}><Icon name="phone-call" size={22} />{phoneText()}</a>
        </div>
        <div class="aside-card aside-card--light">
          <h2>What happens next</h2>
          <ul class="aside-list">
            <li><Icon name="circle-check" size={20} /><span>We review your request and call or text you.</span></li>
            <li><Icon name="circle-check" size={20} /><span>You get a clear estimate before any work starts.</span></li>
            <li><Icon name="circle-check" size={20} /><span>We schedule you in, or send help if you&rsquo;re on the road.</span></li>
          </ul>
        </div>
        <div class="aside-card aside-card--light">
          <h2>Hours</h2>
          <div class="hours--compact"><HoursTable /></div>
        </div>
      </aside>
    </div>
  </section>
</Base>
