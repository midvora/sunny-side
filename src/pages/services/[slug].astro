---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import Steps from '../../components/Steps.astro';
import FaqList from '../../components/FaqList.astro';
import HoursTable from '../../components/HoursTable.astro';
import CtaBand from '../../components/CtaBand.astro';
import { fillDeep, getService, hours, phoneText, serviceCategories, serviceHref, services, tel, value, withBase } from '../../lib/site';
import { breadcrumbs, serviceLd } from '../../lib/seo';
import { LAUNCH } from '../../lib/site';

export function getStaticPaths() {
  return services.filter((s) => !s.href).map((s) => ({ params: { slug: s.slug } }));
}

const { slug } = Astro.params;
const service = fillDeep(getService(slug!));
const category = serviceCategories.find((c) => c.id === service.category)!;
const related = (service.related ?? []).map((r) => getService(r));
const faqs = [{ id: service.slug, name: '', items: service.faqs ?? [] }];
const city = value('location').split(',')[0];
const crumbs = [{ name: 'Services', href: 'services/' }, { name: service.name }];
const schema = LAUNCH ? [breadcrumbs(crumbs), serviceLd(service)] : [];
---
<Base title={service.title} description={service.description} schema={schema}>
  <PageHero eyebrow={category.name} title={service.name} lead={service.lead} image={service.image} crumbs={crumbs} />

  <section class="section">
    <div class="wrap detail">
      <div class="detail__main">
        <div class="detail__intro" data-reveal>
          {service.intro?.map((p) => <p>{p}</p>)}
        </div>

        <div data-reveal>
          <h2>What we handle</h2>
          <ul class="ticks ticks--cols">
            {service.included?.map((i) => <li><Icon name="circle-check" size={22} /> {i}</li>)}
          </ul>
        </div>

        {service.signs && (
          <div data-reveal>
            <h2>Signs you need this</h2>
            <ul class="signs">
              {service.signs.map((s) => <li><Icon name="triangle-alert" size={20} /> <span>{s}</span></li>)}
            </ul>
          </div>
        )}

        {service.steps && (
          <div>
            <h2 data-reveal>How it works</h2>
            <Steps steps={service.steps} />
          </div>
        )}

        {service.faqs && (
          <div>
            <h2 data-reveal>Common questions</h2>
            <FaqList groups={faqs} openFirst />
          </div>
        )}
      </div>

      <aside class="detail__aside" aria-label="Contact and related services">
        <div class="aside-card">
          <h3>Talk to a technician</h3>
          <p>Describe what's going on and we'll tell you what to do next.</p>
          <a class="btn btn--primary btn--lg" href={tel()}><Icon name="phone-call" size={22} /> {phoneText()}</a>
          <p class="mt-s"><a class="btn btn--ghost btn--sm" href={withBase('request-service/')}>Request service online</a></p>
        </div>
        <div class="aside-card aside-card--light">
          <h3>Hours</h3>
          <div class="hours--compact"><HoursTable /></div>
          <p class="mt-s">Roadside: {value('emergency')}</p>
        </div>
        {related.length > 0 && (
          <div class="aside-card aside-card--light">
            <h3>Related services</h3>
            <ul class="related">
              {related.map((r) => (
                <li><a href={serviceHref(r)}><span class="mega__icon"><Icon name={r.icon} size={18} /></span>{r.name}</a></li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </section>

  <CtaBand title={`Need ${service.name.toLowerCase()} in ${city}?`} text="Call now or send a request, and we'll get you on the schedule." />
</Base>
