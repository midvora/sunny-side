---
interface Props {
  size?: number;
}
const { size = 36 } = Astro.props;
const rays = Array.from({ length: 8 }, (_, i) => i * 45);
---
<svg class="sunmark" width={size} height={size} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <circle cx="24" cy="24" r="10" fill="#ffc21a" />
  {rays.map((deg) => (
    <line x1="24" y1="4.5" x2="24" y2="10" stroke="#ffc21a" stroke-width="3.4" stroke-linecap="round" transform={`rotate(${deg} 24 24)`} />
  ))}
</svg>
