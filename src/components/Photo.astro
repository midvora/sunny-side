---
import { Image } from 'astro:assets';
import { photo } from '../lib/images';

interface Props {
  name: string;
  alt?: string;
  sizes?: string;
  widths?: number[];
  class?: string;
  priority?: boolean;
  lowPriority?: boolean;
  decorative?: boolean;
}

const {
  name,
  alt,
  sizes = '100vw',
  widths = [480, 800, 1200, 1600],
  class: cls,
  priority = false,
  lowPriority = false,
  decorative = false,
} = Astro.props;
const p = photo(name);
---
<Image
  src={p.meta}
  alt={decorative ? '' : (alt ?? p.alt)}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={72}
  class={cls}
  data-focal={p.focal}
  loading={priority ? 'eager' : 'lazy'}
  fetchpriority={priority ? 'high' : lowPriority ? 'low' : 'auto'}
  decoding={priority ? 'sync' : 'async'}
/>
