{
  "name": "sunny-side-concept",
  "version": "0.1.0",
  "description": "Private concept website for Sunny Side, a truck and trailer repair business in Garland, Texas. Placeholders until the business confirms its details.",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "gate": "node scripts/launch-gate.mjs",
    "build:launch": "node scripts/launch-gate.mjs && PUBLIC_LAUNCH=true astro build",
    "punchlist": "node scripts/punchlist.mjs",
    "test:unit": "node --test \"scripts/*.test.mjs\"",
    "test:e2e": "playwright test",
    "lint:html": "html-validate dist",
    "lighthouse": "node scripts/lighthouse.mjs",
    "verify": "npm run check && npm run build && npm run test:unit && npm run test:e2e && npm run lint:html && npm run lighthouse"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "astro": "^7.4.0",
    "lucide-static": "^1.58.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "chrome-launcher": "^1.2.2",
    "html-validate": "^11.16.2",
    "lighthouse": "^13.5.0"
  }
}
